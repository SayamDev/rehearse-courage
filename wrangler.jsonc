{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Free Cloudflare Workers plan. No R2, KV or paid bindings, so nothing here can bill.
	// Workers AI on the free plan stops at the daily free allocation instead of charging.
	"main": ".open-next/worker.js",
	"name": "rehearse-courage",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference, required by the adapter. Must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "rehearse-courage"
		}
	],
	// Backup AI (after Groq) and the Llama Guard safety check, for people aged 13 and over.
	"ai": { "binding": "AI" },
	"observability": { "enabled": false }
}
